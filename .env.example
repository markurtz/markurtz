# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` (ignored by git): cp .env.example .env.local
# 2. Fill in values for the features you are working on.
# 3. DO NOT commit real secrets. Production values live in the Vercel project's
#    environment variables, not in this repository.
#
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle.
# Never put a secret behind that prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# Site
# ------------------------------------------------------------------------------
# Canonical origin of the site, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Feature configuration
# ------------------------------------------------------------------------------
# Add a documented entry here whenever a feature introduces a new variable
# (database, auth, object storage, analytics, ...). Keep one section per
# service and note whether each value is public or secret.
