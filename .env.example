# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` (ignored by git): cp .env.example .env.local
# 2. Fill in values for the features you are working on.
# 3. DO NOT commit real secrets. Production values live in the Vercel project's
#    environment variables, not in this repository.
#
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle.
# Never put a secret behind that prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# Site
# ------------------------------------------------------------------------------
# Canonical origin of the site, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Feature switches
# ------------------------------------------------------------------------------
# The public site needs nothing below this line. Turning a private area on
# requires the database, auth, storage and session values further down, and a
# production build fails with a clear message if any of them is missing.
# Setup steps: docs/guides/deploy.md
FEATURE_CLIENT_GALLERIES=false
FEATURE_GATED_PAGES=false

# ------------------------------------------------------------------------------
# Database (Supabase Postgres). Secret, server only.
# ------------------------------------------------------------------------------
# Runtime connection: the Supabase transaction pooler string (port 6543).
# For local work without an account use an in-process database instead:
#   DATABASE_URL=pglite://.data/dev/db
DATABASE_URL=
# Direct connection (port 5432), used only by `pnpm db:migrate` and backups.
DATABASE_URL_DIRECT=

# ------------------------------------------------------------------------------
# Sign-in (Supabase Auth) for the admin and invited clients
# ------------------------------------------------------------------------------
# "supabase" in production. "dev" accepts the code 000000 for any allowed email
# and is refused on Vercel; it exists for local work and the e2e tests.
AUTH_DRIVER=supabase
# Public by design (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret, server only. Never give this a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=
# Comma separated emails that may open /admin.
ADMIN_EMAILS=

# ------------------------------------------------------------------------------
# Sessions and housekeeping. Secret, server only.
# ------------------------------------------------------------------------------
# Signs the passcode session cookie. At least 32 characters: openssl rand -hex 32
GALLERY_SESSION_SECRET=
# Salts the hashed IP addresses in the access log: openssl rand -hex 16
IP_HASH_SALT=
# Shared with the keepalive workflow, which archives expired galleries.
CRON_SECRET=

# ------------------------------------------------------------------------------
# Media storage (Cloudflare R2)
# ------------------------------------------------------------------------------
# "r2" in production. "local" keeps public media in public/media and private
# media in .data/media, for local work and the e2e tests.
STORAGE_DRIVER=r2
# Secret, server only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# Public origin of the public bucket (for example https://media.example.com).
# Leave empty to serve public photos from public/media in this repository.
NEXT_PUBLIC_MEDIA_URL=

# ------------------------------------------------------------------------------
# Contact form (Resend). Only when features.contact is on in site.config.ts.
# ------------------------------------------------------------------------------
# Secret, server only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ------------------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------------------
# Raises the GitHub API rate limit for repository star counts at build time.
GITHUB_TOKEN=
# Set to 1 to skip those GitHub requests entirely (offline builds, tests).
SKIP_GITHUB_STATS=

# ------------------------------------------------------------------------------
# Blog syndication. Set these as GitHub Actions secrets, not here, unless you
# run `pnpm syndicate` from your own machine.
# ------------------------------------------------------------------------------
DEVTO_API_KEY=
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=
