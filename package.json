{
  "name": "markurtz",
  "version": "0.1.0",
  "private": true,
  "description": "Source for Mark Kurtz's personal website and GitHub profile README.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/markurtz/markurtz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markurtz/markurtz.git"
  },
  "bugs": {
    "url": "https://github.com/markurtz/markurtz/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "velite build && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "velite build && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "content": "velite build"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@electric-sql/pglite": "^0.5.16",
    "@google/model-viewer": "^4.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "feed": "^6.0.0",
    "geist": "^1.9.2",
    "jose": "^6.2.17",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "minisearch": "^7.2.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "thumbhash": "^0.1.1",
    "velite": "^0.4.0",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "vitest": "^5.1.0"
  }
}
